@page "/administration/schedule/replacefaileddelivery"
@layout Layout.AdminLayout

<CheckAuth Roles=@RoleNames.CanManageBedRequests></CheckAuth>

<h3 class="mt-3">Replace Failed Delivery</h3>

@if (WorkflowStep == PickSchedule)
{
    <div class="content-wrapper mt-3">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">Choose the Delivery Event</div>
                    <div class="card-body">
                        <div class="form-group">
                            <label for="ScheduleDropdown" class="formlabel">Delivery Event</label>
                            <SfDropDownList ID="ScheduleDropdown" TItem="BedBrigade.Common.Models.Schedule" TValue="int?" DataSource="FutureDeliverySchedules" @bind-Value="ScheduleId" Enabled="true" Placeholder="Select Delivery Event" FloatLabelType="FloatLabelType.Never">
                                <DropDownListFieldSettings Value="ScheduleId" Text="EventSelect" />
                                <DropDownListEvents TValue="int?" TItem="BedBrigade.Common.Models.Schedule" ValueChange="OnScheduleChange"></DropDownListEvents>
                            </SfDropDownList>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-1">
        <div class="col-md-12 text-left">
            <button class="btn btn-primary" type="button" disabled="@_chooseEventButtonDisabled"  @onclick="ChooseEventNext">Next ></button>
        </div>
    </div>    
}
else if (WorkflowStep == PickFailedDelivery)
{
    if (!BedRequests.Any())
    {
        <p>There are no Bed Requests scheduled for the selected event.</p>
        <div class="row mt-1">
            <div class="col-md-12 text-left">
                <a href="/administration/schedule/replacefaileddelivery" class="btn btn-primary">Back</a>
            </div>
        </div> 
    }
    else
    {
        <table class="table table-bordered">
            <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Team</th>
                <th scope="col">Number of Beds</th>
            </tr>
            </thead>
            <tbody>
            @{
                string lastTeam = BedRequests.FirstOrDefault()?.Team ?? string.Empty;
                string contextualClass = "table-default";
            }
            @for (int i = 0; i < BedRequests.Count; i++)
            {
                //We just keep adding on to the _baseUrl
                string url = $"{_baseUrl}&failedBedRequestId={BedRequests[i].BedRequestId}";

                @if (BedRequests[i].Team != lastTeam)
                {
                    lastTeam = BedRequests[i].Team;
                    contextualClass = contextualClass == "table-default" ? "table-active" : "table-default";
                }

                <tr class="@contextualClass">
                    <td><a href="@url">@BedRequests[i].FullName</a></td>
                    <td>@BedRequests[i].Team</td>
                    <td>@BedRequests[i].NumberOfBeds</td>
                </tr>
            }
            </tbody>
        </table>
    }
}
